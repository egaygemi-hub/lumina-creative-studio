<%- include('partials/head',{title:'Insights — '+settings.business_name}) %><%- include('partials/header') %><main class="section"><div class="container"><div class="eyebrow">Insights</div><h1>Notes from the studio.</h1><div class="posts"><% posts.forEach(p=>{ %><article class="post-card"><div class="post-body"><div class="eyebrow"><%= p.category %></div><h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3><p><%= p.excerpt %></p></div></article><% }) %></div></div></main><%- include('partials/footer') %>