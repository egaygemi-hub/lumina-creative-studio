<%- include('partials/head',{title:'Services — '+settings.business_name}) %><%- include('partials/header') %><main class="section"><div class="container"><div class="eyebrow">Services</div><h1>Built around the business, not the template.</h1><div class="services"><% services.forEach((s,i)=>{ %><article class="service"><div class="service-num">0<%= i+1 %></div><h3><%= s.name %></h3><p><%= s.description %></p><p><strong>Best for:</strong> <%= s.ideal_customer %></p><p><strong>Outcome:</strong> <%= s.benefit %></p><a href="/services/<%= s.slug %>"><%= s.cta %> →</a></article><% }) %></div></div></main><%- include('partials/footer') %>