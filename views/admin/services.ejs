<%- include('layout-head',{title:'Services — Lumina'}) %><div class="page-title"><div><h1>Services</h1><p>Edit services displayed on the public website.</p></div><a class="btn" href="/admin/services/new">Add service</a></div><div class="panel table-wrap"><table><tr><th>Name</th><th>Status</th><th></th></tr><% services.forEach(s=>{ %><tr><td><strong><%= s.name %></strong><br><small>/<%= s.slug %></small></td><td><%= s.status %></td><td><a class="btn secondary" href="/admin/services/<%= s.id %>/edit">Edit</a> <form method="post" action="/admin/services/<%= s.id %>/delete" style="display:inline"><button class="btn danger">Delete</button></form></td></tr><% }) %></table></div><%- include('layout-foot') %>