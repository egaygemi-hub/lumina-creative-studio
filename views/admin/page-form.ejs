<%- include('layout-head',{title:'Edit Page — Lumina'}) %><div class="page-title"><h1>Edit page</h1></div><form method="post" action="/admin/pages/<%= page.id %>" class="panel"><div class="form-grid"><div class="field"><label>Title</label><input name="title" value="<%= page.title %>" required></div><div class="field"><label>Status</label><select name="status"><option <%= page.status==='draft'?'selected':'' %>>draft</option><option <%= page.status==='published'?'selected':'' %>>published</option></select></div><div class="field full"><label>Content (HTML)</label><textarea name="content"><%= page.content %></textarea></div><div class="field"><label>SEO title</label><input name="seo_title" value="<%= page.seo_title||'' %>"></div><div class="field"><label>Meta description</label><input name="meta_description" value="<%= page.meta_description||'' %>"></div></div><button class="btn">Save page</button></form><%- include('layout-foot') %>