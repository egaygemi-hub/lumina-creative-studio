<%- include('layout-head',{title:'Pages — Lumina'}) %><div class="page-title"><h1>Pages</h1></div><div class="panel"><h3>Create page</h3><form method="post" action="/admin/pages"><div class="form-grid"><div class="field"><label>Title</label><input name="title" required></div><div class="field"><label>Slug</label><input name="slug"></div><div class="field full"><label>Content (HTML)</label><textarea name="content"></textarea></div><div class="field"><label>Status</label><select name="status"><option>draft</option><option>published</option></select></div></div><button class="btn">Create page</button></form></div><div class="panel"><table><tr><th>Page</th><th>Status</th><th></th></tr><% pages.forEach(p=>{ %><tr><td><%= p.title %><br><small>/<%= p.slug %></small></td><td><%= p.status %></td><td><a class="btn secondary" href="/admin/pages/<%= p.id %>/edit">Edit</a></td></tr><% }) %></table></div><%- include('layout-foot') %>