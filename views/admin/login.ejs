<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Login — Lumina</title><link rel="stylesheet" href="/css/admin.css"></head><body class="login"><div class="login-box"><div class="brand">Lumina<span>.</span> CMS</div><h1>Sign in</h1><p>Manage the sample website without editing code.</p><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" action="/admin/login"><div class="field"><label>Email</label><input type="email" name="email" required></div><div class="field"><label>Password</label><input type="password" name="password" required></div><button class="btn">Sign in</button></form><p>Demo credentials are defined by ADMIN_EMAIL / ADMIN_PASSWORD.</p></div></body></html>