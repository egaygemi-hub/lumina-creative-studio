<%- include('layout-head',{title:(service?'Edit':'Add')+' Service — Lumina'}) %><div class="page-title"><h1><%= service?'Edit':'Add' %> service</h1></div><form method="post" action="<%= service?'/admin/services/'+service.id:'/admin/services' %>" class="panel"><div class="form-grid"><div class="field"><label>Name</label><input name="name" value="<%= service?.name||'' %>" required></div><div class="field"><label>Slug</label><input name="slug" value="<%= service?.slug||'' %>"></div><div class="field full"><label>Description</label><textarea name="description" required><%= service?.description||'' %></textarea></div><div class="field"><label>Ideal customer</label><input name="ideal_customer" value="<%= service?.ideal_customer||'' %>"></div><div class="field"><label>Benefit</label><input name="benefit" value="<%= service?.benefit||'' %>"></div><div class="field"><label>Differentiator</label><input name="differentiator" value="<%= service?.differentiator||'' %>"></div><div class="field"><label>CTA</label><input name="cta" value="<%= service?.cta||'Learn more' %>"></div><div class="field"><label>Status</label><select name="status"><option value="published">Published</option><option value="draft">Draft</option></select></div></div><button class="btn">Save service</button></form><%- include('layout-foot') %>