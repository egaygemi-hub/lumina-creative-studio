<%- include('layout-head',{title:'Settings — Lumina'}) %><div class="page-title"><h1>Site settings</h1></div><% if(saved){ %><div class="toast">Settings saved.</div><% } %><form method="post" action="/admin/settings" class="panel"><div class="form-grid"><% [['business_name','Business name'],['tagline','Tagline'],['email','Email'],['phone','Phone'],['address','Address'],['hours','Business hours'],['primary_cta','Primary CTA'],['secondary_cta','Secondary CTA']].forEach(x=>{ %><div class="field"><label><%= x[1] %></label><input name="<%= x[0] %>" value="<%= settings[x[0]]||'' %>"></div><% }) %></div><button class="btn">Save settings</button></form><%- include('layout-foot') %>