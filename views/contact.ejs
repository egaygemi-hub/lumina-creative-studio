<%- include('partials/head',{title:'Contact — '+settings.business_name}) %><%- include('partials/header') %><main class="section"><div class="container form-wrap"><div class="eyebrow">Contact</div><h1>Tell us what you're trying to make better.</h1><p class="muted">Submissions are stored in the admin CMS.</p><% if(sent){ %><div class="notice">Thanks — your message has been received.</div><% } %><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" action="/contact"><div class="form-grid"><div class="field"><label>Name *</label><input name="name" required></div><div class="field"><label>Email *</label><input type="email" name="email" required></div><div class="field"><label>Phone</label><input name="phone"></div><div class="field full"><label>What can we help with? *</label><textarea name="message" required></textarea></div></div><button class="btn">Send inquiry</button></form></div></main><%- include('partials/footer') %>